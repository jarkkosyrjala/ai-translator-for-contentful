# Copy this file to .env.static.local for a Custom backend installation that
# uses the static App Bundle. The local file is ignored by Git. Never commit
# real tokens. upload:static-ci and check:static-upload load only this file,
# never .env.function.local. Shell or CI variables take precedence.
# For several installations, keep one ignored .env.<name>.local file per
# installation and pass --env-file <path>.

# Organization ID: Organization settings & subscriptions > Organization
# information, or after /organizations/ in the browser URL.
CONTENTFUL_ORG_ID=
# The App Definition that receives the static App Bundle. It must have no Functions.
CONTENTFUL_APP_DEF_ID=
# Personal access token (CMA token) with the content_management_manage scope,
# from a user who can manage apps in this organization: Settings > CMA tokens.
CONTENTFUL_ACCESS_TOKEN=
