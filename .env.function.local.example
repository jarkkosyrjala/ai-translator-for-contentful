# Copy this file to .env.function.local and fill in the values for your
# installation. The local file is ignored by Git. Never commit real provider
# hosts or tokens. For several installations, keep one ignored
# .env.<name>.local file per installation and pass --env-file <path> to the
# Function commands.

# JSON array of exact provider hostnames, with :port for a non-default HTTPS port.
# For Provider URL https://model.example/v1, use '["model.example"]'.
# Do not put https:// or a path in this list.
# Two providers: '["model.example", "second.example:8443"]'
# An empty array is rejected for a Function upload.
CONTENTFUL_FUNCTION_ALLOW_NETWORKS='[]'

# Required for sync:parameters, upload:function-ci, and sync:function-action.
# Organization ID: Organization settings & subscriptions > Organization
# information, or after /organizations/ in the browser URL.
# App Definition ID: shown on the app's App details page and in its URL.
# It is not the space ID.
# Access token: a personal access token (CMA token) with the
# content_management_manage scope, from a user who can manage apps in this
# organization: Settings > CMA tokens. Delivery and Preview API tokens cannot
# manage App Definitions.
CONTENTFUL_ORG_ID=
CONTENTFUL_APP_DEF_ID=
CONTENTFUL_ACCESS_TOKEN=
