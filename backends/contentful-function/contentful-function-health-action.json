{
  "name": "Test Function connection",
  "description": "Validate saved provider configuration without a model call.",
  "type": "function-invocation",
  "function": {
    "sys": {
      "type": "Link",
      "linkType": "Function",
      "id": "functionHealth"
    }
  },
  "category": "Custom",
  "parametersSchema": {
    "type": "object",
    "properties": {
      "contract": {
        "type": "integer",
        "enum": [1]
      }
    },
    "required": ["contract"],
    "additionalProperties": false
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "contract": {
        "type": "integer",
        "enum": [1]
      },
      "status": {
        "type": "string",
        "enum": ["ok", "failed"]
      },
      "modelCall": {
        "type": "boolean",
        "enum": [false]
      },
      "providerConfigured": {
        "type": "boolean",
        "enum": [true]
      },
      "providerHost": {
        "type": "string",
        "maxLength": 253
      },
      "models": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "defaultModel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "profileRevision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "errorCode": {
        "type": "string",
        "enum": [
          "function_not_configured",
          "profile_invalid",
          "invalid_provider_url",
          "model_list_unavailable",
          "unsupported_contract",
          "invalid_request",
          "unexpected_property",
          "same_locale",
          "request_too_large",
          "model_not_allowed",
          "provider_not_allowed",
          "provider_rate_limited",
          "provider_auth_failed",
          "provider_timeout",
          "provider_truncated",
          "provider_incomplete",
          "provider_refused",
          "provider_request_too_large",
          "invalid_provider_response",
          "result_too_large",
          "provider_failed"
        ]
      },
      "limits": {
        "type": "object",
        "properties": {
          "requestBytes": {
            "type": "integer",
            "minimum": 1
          },
          "providerBodyBytes": {
            "type": "integer",
            "minimum": 1
          },
          "resultBytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["requestBytes", "providerBodyBytes", "resultBytes"],
        "additionalProperties": false
      },
      "timeoutSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 27
      }
    },
    "required": ["contract", "status", "modelCall"],
    "additionalProperties": false
  }
}
